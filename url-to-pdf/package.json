{
  "name": "url-to-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Convert a web page URL to PDF with Puppeteer: print or screen CSS, lazy images, cookie banners, logins, single-page apps and wide pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test-site": "node test-site/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "5.3.0",
    "puppeteer": "25.16.0"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "playwright": "1.65.0"
  }
}
